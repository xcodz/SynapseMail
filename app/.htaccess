# SynapseMail (Roundcube 1.7) serves everything from /public_html; route this install folder into it.
# Works in a sub folder such as public_html/mail on cPanel.
<IfModule mod_rewrite.c>
RewriteEngine On
# assets: static.php reads the file path from the original request URI (no PATH_INFO needed)
RewriteRule ^static\.php/ public_html/static.php [L]
RewriteRule ^((?!public_html/).*)$ public_html/$1 [L]
</IfModule>
<IfModule mod_autoindex.c>
Options -Indexes
</IfModule>
