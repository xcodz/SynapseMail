# SynapseMail update server (https://repo.synapsecyber.io/synapsemail/), version {{VERSION}}
# Copyright (c) 2026 SynapseCyber.io. CC BY-NC-ND 4.0.
Options -Indexes
DirectoryIndex index.html
AddType application/json .json
AddType text/plain .sig .sha256
AddType application/zip .zip
AddCharset utf-8 .json .sig .sha256 .html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  <FilesMatch "^(release\.json|release\.json\.sig|SHA256SUMS)$">
    Header set Cache-Control "no-cache, max-age=0"
  </FilesMatch>
  <FilesMatch "\.zip$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
# hidden files other than this one are never served
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
