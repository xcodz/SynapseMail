# SynapseMail WHM plugin (https://repo.synapsecyber.io/synapsemail/whm-plugin-only/)
# Copyright (c) 2026 SynapseCyber.io. CC BY-NC-ND 4.0.
Options -Indexes
DirectoryIndex index.html
# install.sh is shown as text in a browser and downloaded as-is by curl
AddType text/plain .sh
AddType application/gzip .gz
AddType application/octet-stream .sig
AddCharset utf-8 .sh .html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  <FilesMatch "^(install\.sh|SHA256SUMS|SHA256SUMS\.sig|index\.html)$">
    Header set Cache-Control "no-cache, max-age=0"
  </FilesMatch>
  <FilesMatch "\.tar\.gz$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
# hidden files other than this one are never served
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
